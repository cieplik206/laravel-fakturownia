{
    "name": "cieplik206/laravel-fakturownia",
    "description": "Laravel client for the Fakturownia (InvoiceOcean) REST API",
    "keywords": [
        "api-client",
        "fakturownia",
        "invoiceocean",
        "ksef",
        "laravel",
        "saloon",
        "php"
    ],
    "homepage": "https://github.com/cieplik206/laravel-fakturownia",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Paweł Ciepliński",
            "homepage": "https://github.com/cieplik206",
            "role": "Developer"
        }
    ],
    "support": {
        "docs": "https://github.com/cieplik206/laravel-fakturownia#readme",
        "issues": "https://github.com/cieplik206/laravel-fakturownia/issues",
        "security": "https://github.com/cieplik206/laravel-fakturownia/security/policy",
        "source": "https://github.com/cieplik206/laravel-fakturownia"
    },
    "require": {
        "php": "^8.4",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-sodium": "*",
        "cieplik206/laravel-integration-operations": "^0.3.7",
        "illuminate/cache": "^13.17",
        "illuminate/console": "^13.17",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.17",
        "illuminate/support": "^13.0",
        "saloonphp/laravel-plugin": "^4.0",
        "saloonphp/saloon": "^4.0",
        "spatie/laravel-data": "^4.11"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "pestphp/pest-plugin-phpstan": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Cieplik206\\Fakturownia\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cieplik206\\Fakturownia\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Cieplik206\\Fakturownia\\Laravel\\FakturowniaServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest --exclude-group=live --exclude-group=postgres",
        "test:pgsql": "pest --fail-on-skipped --fail-on-empty-test-suite --group=postgres",
        "test:compatibility:min": [
            "@composer update --prefer-lowest --prefer-stable --no-interaction --no-progress",
            "@test"
        ],
        "test:compatibility:locked": [
            "git ls-files --error-unmatch composer.lock",
            "@php -r \"if (! is_file('composer.lock')) { fwrite(STDERR, 'A committed composer.lock is required for the locked compatibility gate.'.PHP_EOL); exit(1); }\"",
            "@composer install --no-interaction --no-progress",
            "@test"
        ],
        "test:compatibility:latest": [
            "@composer update --prefer-stable --no-interaction --no-progress",
            "@test"
        ],
        "probe:invoice-identity": "pest tests/Contract/InvoiceIdentityContractProbeTest.php",
        "probe:ksef-demo": "pest tests/Contract/KsefDemoContractProbeTest.php",
        "analyse": "phpstan analyse",
        "format": "pint src tests config database bin",
        "format:check": "pint --test src tests config database bin",
        "quality:validate": "@composer validate --strict",
        "security:audit": "@composer audit",
        "check": [
            "@quality:validate",
            "@format:check",
            "@analyse",
            "@test",
            "@test:pgsql",
            "@security:audit"
        ]
    },
    "replace": {
        "cieplik206/laravel-fakturownia-client": "self.version"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    }
}
